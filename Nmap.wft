--// Функция уведомления (уменьшена высота, ширина прежняя)
local function ShowNotification(text)
    local NotificationShadow = Instance.new("Frame")
    NotificationShadow.Name = "NotificationShadow"
    NotificationShadow.Size = UDim2.new(0, 150, 0, 24) -- было 30
    NotificationShadow.Position = UDim2.new(1, 150, 0.5, -75)
    NotificationShadow.BackgroundColor3 = Colors.Shadow
    NotificationShadow.BackgroundTransparency = 0.25
    NotificationShadow.BorderSizePixel = 0
    NotificationShadow.ZIndex = 99
    NotificationShadow.Parent = ScreenGui

    local NotificationFrame = Instance.new("Frame")
    NotificationFrame.Name = "Notification"
    NotificationFrame.Size = UDim2.new(0, 142, 0, 16) -- было 22
    NotificationFrame.Position = UDim2.new(1, 154, 0.5, -71)
    NotificationFrame.BackgroundColor3 = Colors.Panel
    NotificationFrame.BorderSizePixel = 0
    NotificationFrame.ZIndex = 100
    NotificationFrame.Parent = ScreenGui

    local AccentBar = Instance.new("Frame")
    AccentBar.Size = UDim2.new(0, 2, 1, 0)
    AccentBar.BackgroundColor3 = Colors.Accent2
    AccentBar.BorderSizePixel = 0
    AccentBar.ZIndex = 101
    AccentBar.Parent = NotificationFrame

    local NotificationText = Instance.new("TextLabel")
    NotificationText.Size = UDim2.new(1, -12, 1, 0)
    NotificationText.Position = UDim2.new(0, 6, 0, 0)
    NotificationText.BackgroundTransparency = 1
    NotificationText.Font = Enum.Font.GothamBold
    NotificationText.Text = text
    NotificationText.TextColor3 = Colors.Text
    NotificationText.TextSize = 9
    NotificationText.ZIndex = 102
    NotificationText.AutoLocalize = false
    NotificationText.Parent = NotificationFrame

    local tweenInShadow = TweenService:Create(NotificationShadow, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Position = UDim2.new(1, -156, 0.5, -75)})
    tweenInShadow:Play()

    local tweenIn = TweenService:Create(NotificationFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Position = UDim2.new(1, -152, 0.5, -71)})
    tweenIn:Play()

    wait(3)

    local tweenOutShadow = TweenService:Create(NotificationShadow, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        {Position = UDim2.new(1, 150, 0.5, -75)})
    tweenOutShadow:Play()

    local tweenOut = TweenService:Create(NotificationFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        {Position = UDim2.new(1, 154, 0.5, -71)})
    tweenOut:Play()

    tweenOut.Completed:Connect(function()
        NotificationFrame:Destroy()
        NotificationShadow:Destroy()
    end)
end

--// Создание вкладок
local function CreateTab(name, layoutOrder)
    local TabButton = Instance.new("TextButton")
    TabButton.Name = name .. "Tab"
    TabButton.Size = UDim2.new(1, -8, 0, 17)
    TabButton.Position = UDim2.new(0, 4, 0, 4 + (layoutOrder - 1) * 20)
    TabButton.BackgroundColor3 = Colors.Hover
    TabButton.BorderSizePixel = 0
    TabButton.Font = Enum.Font.GothamBold
    TabButton.Text = ""
    TabButton.AutoLocalize = false
    TabButton.ZIndex = 4
    TabButton.Active = true
    TabButton.Parent = TabPanel

    local TabLabel = Instance.new("TextLabel")
    TabLabel.Name = "Label"
    TabLabel.Size = UDim2.new(1, 0, 1, 0)
    TabLabel.BackgroundTransparency = 1
    TabLabel.Font = Enum.Font.GothamBold
    TabLabel.Text = name
    TabLabel.TextColor3 = Colors.TextSecondary
    TabLabel.TextSize = 6
    TabLabel.AutoLocalize = false
    TabLabel.ZIndex = 5
    TabLabel.Parent = TabButton

    TabButton.MouseEnter:Connect(function()
        if TabLabel.TextColor3 ~= Colors.Text then
            TweenService:Create(TabButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(235, 235, 240)}):Play()
        end
    end)
    TabButton.MouseLeave:Connect(function()
        if TabLabel.TextColor3 ~= Colors.Text then
            TweenService:Create(TabButton, TweenInfo.new(0.2), {BackgroundColor3 = Colors.Hover}):Play()
        end
    end)

    return TabButton, TabLabel
end

local function CreateTabContent(name)
    local Content = Instance.new("ScrollingFrame")
    Content.Name = name .. "Content"
    Content.Size = UDim2.new(1, 0, 1, 0)
    Content.Position = UDim2.new(0, 0, 0, 0)
    Content.BackgroundTransparency = 1
    Content.BorderSizePixel = 0
    Content.ScrollBarThickness = 2
    Content.ScrollBarImageColor3 = Colors.Border
    Content.CanvasSize = UDim2.new(0, 0, 0, 0)
    Content.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Content.ZIndex = 3
    Content.Active = true
    Content.Visible = false
    Content.Parent = ContentContainer

    local UIListLayout = Instance.new("UIListLayout")
    UIListLayout.Name = "FunctionList"
    UIListLayout.Padding = UDim.new(0, 4)
    UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    UIListLayout.Parent = Content

    return Content
end

local MiscTabButton, MiscTabLabel = CreateTab("Misc", 1)
local TeleportTabButton, TeleportTabLabel = CreateTab("Exploit", 2)
local SettingsTabButton, SettingsTabLabel = CreateTab("Settings", 3)

local MiscTabContent = CreateTabContent("Misc")
local TeleportTabContent = CreateTabContent("Exploit")
local SettingsTabContent = CreateTabContent("Settings")

local function SwitchTab(tabName)
    MiscTabContent.Visible = false
    TeleportTabContent.Visible = false
    SettingsTabContent.Visible = false

    TweenService:Create(MiscTabButton, TweenInfo.new(0.2), {BackgroundColor3 = Colors.Hover}):Play()
    TweenService:Create(TeleportTabButton, TweenInfo.new(0.2), {BackgroundColor3 = Colors.Hover}):Play()
    TweenService:Create(SettingsTabButton, TweenInfo.new(0.2), {BackgroundColor3 = Colors.Hover}):Play()

    MiscTabLabel.TextColor3 = Colors.TextSecondary
    TeleportTabLabel.TextColor3 = Colors.TextSecondary
    SettingsTabLabel.TextColor3 = Colors.TextSecondary

    if tabName == "Misc" then
        MiscTabContent.Visible = true
        TweenService:Create(MiscTabButton, TweenInfo.new(0.2), {BackgroundColor3 = Colors.Panel}):Play()
        MiscTabLabel.TextColor3 = Colors.Text
    elseif tabName == "Exploit" then
        TeleportTabContent.Visible = true
        TweenService:Create(TeleportTabButton, TweenInfo.new(0.2), {BackgroundColor3 = Colors.Panel}):Play()
        TeleportTabLabel.TextColor3 = Colors.Text
    elseif tabName == "Settings" then
        SettingsTabContent.Visible = true
        TweenService:Create(SettingsTabButton, TweenInfo.new(0.2), {BackgroundColor3 = Colors.Panel}):Play()
        SettingsTabLabel.TextColor3 = Colors.Text
    end
end

MiscTabButton.MouseButton1Click:Connect(function() SwitchTab("Misc") end)
TeleportTabButton.MouseButton1Click:Connect(function() SwitchTab("Exploit") end)
SettingsTabButton.MouseButton1Click:Connect(function() SwitchTab("Settings") end)

--// Функция создания элемента функции
local function CreateFunctionInTab(parent, name, description, layoutOrder, callback)
    local FunctionFrame = Instance.new("Frame")
    FunctionFrame.Name = name .. "_Frame"
    FunctionFrame.Size = UDim2.new(1, -8, 0, 38)
    FunctionFrame.BackgroundColor3 = Colors.Panel
    FunctionFrame.BorderSizePixel = 0
    FunctionFrame.LayoutOrder = layoutOrder
    FunctionFrame.ZIndex = 3
    FunctionFrame.Active = true
    FunctionFrame.Parent = parent

    local AccentBar = Instance.new("Frame")
    AccentBar.Size = UDim2.new(0, 3, 1, 0)
    AccentBar.BackgroundColor3 = Colors.Accent2
    AccentBar.BorderSizePixel = 0
    AccentBar.ZIndex = 4
    AccentBar.Parent = FunctionFrame

    local FunctionName = Instance.new("TextLabel")
    FunctionName.Name = "FunctionName"
    FunctionName.Size = UDim2.new(1, -45, 0, 13)
    FunctionName.Position = UDim2.new(0, 10, 0, 4)
    FunctionName.BackgroundTransparency = 1
    FunctionName.Font = Enum.Font.GothamBold
    FunctionName.Text = name
    FunctionName.TextColor3 = Colors.Text
    FunctionName.TextSize = 9
    FunctionName.TextXAlignment = Enum.TextXAlignment.Left
    FunctionName.ZIndex = 5
    FunctionName.AutoLocalize = false
    FunctionName.Parent = FunctionFrame

    local FunctionDescription = Instance.new("TextLabel")
    FunctionDescription.Name = "Description"
    FunctionDescription.Size = UDim2.new(1, -45, 0, 9)
    FunctionDescription.Position = UDim2.new(0, 10, 0, 19)
    FunctionDescription.BackgroundTransparency = 1
    FunctionDescription.Font = Enum.Font.Gotham
    FunctionDescription.Text = description
    FunctionDescription.TextColor3 = Colors.TextSecondary
    FunctionDescription.TextSize = 5
    FunctionDescription.TextXAlignment = Enum.TextXAlignment.Left
    FunctionDescription.TextWrapped = true
    FunctionDescription.ZIndex = 5
    FunctionDescription.AutoLocalize = false
    FunctionDescription.Parent = FunctionFrame

    local Checkbox = Instance.new("Frame")
    Checkbox.Name = "Checkbox"
    Checkbox.Size = UDim2.new(0, 14, 0, 14)
    Checkbox.Position = UDim2.new(1, -21, 0, 12)
    Checkbox.BackgroundColor3 = Colors.CheckboxOff
    Checkbox.BorderSizePixel = 0
    Checkbox.ZIndex = 6
    Checkbox.Parent = FunctionFrame

    local MainButton = Instance.new("TextButton")
    MainButton.Name = "MainButton"
    MainButton.Size = UDim2.new(1, 0, 1, 0)
    MainButton.Position = UDim2.new(0, 0, 0, 0)
    MainButton.BackgroundTransparency = 1
    MainButton.BorderSizePixel = 0
    MainButton.Text = ""
    MainButton.ZIndex = 7
    MainButton.Active = true
    MainButton.AutoLocalize = false
    MainButton.Parent = FunctionFrame

    local isToggled = false
    local function UpdateToggle()
        if isToggled then
            TweenService:Create(Checkbox, TweenInfo.new(0.2), {BackgroundColor3 = Colors.CheckboxOn}):Play()
        else
            TweenService:Create(Checkbox, TweenInfo.new(0.2), {BackgroundColor3 = Colors.CheckboxOff}):Play()
        end
    end

    MainButton.MouseButton1Click:Connect(function()
        isToggled = not isToggled
        UpdateToggle()
        if callback then
            callback(isToggled)
        end
        if isToggled then
            ShowNotification(name .. " enabled")
        end
    end)

    MainButton.MouseEnter:Connect(function()
        TweenService:Create(FunctionFrame, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(252, 252, 252)}):Play()
    end)
    MainButton.MouseLeave:Connect(function()
        TweenService:Create(FunctionFrame, TweenInfo.new(0.2), {BackgroundColor3 = Colors.Panel}):Play()
    end)

    return {
        Frame = FunctionFrame,
        Checkbox = Checkbox,
        MainButton = MainButton,
        IsToggled = function() return isToggled end,
        SetToggled = function(value)
            isToggled = value
            UpdateToggle()
            if callback then
                callback(isToggled)
            end
        end
    }
end

--// Функция проверки врага
local function IsEnemy(targetPlayer)
    local localPlayer = Players.LocalPlayer
    if targetPlayer.Team and localPlayer.Team then
        return targetPlayer.Team ~= localPlayer.Team
    end
    if not localPlayer.Team then return true end
    if not targetPlayer.Team then return true end
    return false
end

--// Arrows
local ArrowObjects = {}
local ArrowsEnabled = true
local ArrowDistance = 40

local function RemoveAllArrows()
    for playerName, arrowData in pairs(ArrowObjects) do
        if arrowData.Arrow then arrowData.Arrow:Remove() end
        if arrowData.Connection then arrowData.Connection:Disconnect() end
        ArrowObjects[playerName] = nil
    end
end

local function ArrowsFunction(enabled)
    ArrowsEnabled = enabled
    if enabled then
        for _, v in pairs(Players:GetPlayers()) do
            if v ~= player and IsEnemy(v) and not ArrowObjects[v.Name] then
                DrawArrow(v)
            end
        end
        Players.PlayerAdded:Connect(function(newPlayer)
            if newPlayer ~= player and IsEnemy(newPlayer) and not ArrowObjects[newPlayer.Name] then
                wait(1)
                DrawArrow(newPlayer)
            end
        end)
    else
        RemoveAllArrows()
    end
end

function DrawArrow(plr)
    if not IsEnemy(plr) then return end

    local Arrow = Drawing.new("Triangle")
    Arrow.Visible = false
    Arrow.Color = Color3.fromRGB(255, 255, 255)
    Arrow.Thickness = 1
    Arrow.Transparency = 1
    Arrow.Filled = false

    local connection
    connection = game:GetService("RunService").RenderStepped:Connect(function()
        if ArrowObjects[plr.Name] then
            if plr.Character ~= nil and plr.Character:FindFirstChildOfClass("Humanoid") ~= nil and plr.Character:FindFirstChild("HumanoidRootPart") ~= nil and plr.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                local pos, vis = Camera:WorldToViewportPoint(plr.Character.HumanoidRootPart.Position)
                local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

                if ArrowsEnabled and not vis then
                    local direction = Vector2.new(pos.X - screenCenter.X, pos.Y - screenCenter.Y)
                    if direction.Magnitude > 0 then
                        direction = direction.Unit
                        local arrowPos = screenCenter + direction * ArrowDistance

                        local angle = math.atan2(direction.Y, direction.X)
                        local arrowSize = 6.4
                        local p1 = arrowPos + Vector2.new(math.cos(angle) * arrowSize, math.sin(angle) * arrowSize)
                        local p2 = arrowPos + Vector2.new(math.cos(angle + 2.5) * arrowSize, math.sin(angle + 2.5) * arrowSize)
                        local p3 = arrowPos + Vector2.new(math.cos(angle - 2.5) * arrowSize, math.sin(angle - 2.5) * arrowSize)

                        Arrow.PointA = p1
                        Arrow.PointB = p2
                        Arrow.PointC = p3
                        Arrow.Visible = true
                    else
                        Arrow.Visible = false
                    end
                else
                    Arrow.Visible = false
                end
            else
                Arrow.Visible = false
                if game.Players:FindFirstChild(plr.Name) == nil then
                    connection:Disconnect()
                    Arrow:Remove()
                    ArrowObjects[plr.Name] = nil
                end
            end
        else
            Arrow:Remove()
            connection:Disconnect()
        end
    end)

    ArrowObjects[plr.Name] = {
        Arrow = Arrow,
        Connection = connection
    }
end

--// ESP (с автообновлением при смерти/возрождении)
local ESPShowDistance = true
local ESPShowHealth = true
local ESPShowTracer = false

local ESPObjects = {}
local ESPEnabled = false
local ESPConnection = nil

local function RemoveAllESP()
    for playerName, espData in pairs(ESPObjects) do
        if espData.Box then espData.Box:Remove() end
        if espData.HealthBar then espData.HealthBar:Remove() end
        if espData.HealthBarBackground then espData.HealthBarBackground:Remove() end
        if espData.DistanceText then espData.DistanceText:Remove() end
        if espData.Connection then espData.Connection:Disconnect() end
        if espData.CharacterAddedConnection then espData.CharacterAddedConnection:Disconnect() end
        ESPObjects[playerName] = nil
    end
end

local function CreateESP(plr)
    local Box = Drawing.new("Square")
    Box.Visible = false
    Box.Color = Color3.fromRGB(255, 255, 255)
    Box.Thickness = 2
    Box.Transparency = 1
    Box.Filled = false

    local HealthBarBackground = Drawing.new("Line")
    HealthBarBackground.Visible = false
    HealthBarBackground.Color = Color3.fromRGB(50, 50, 50)
    HealthBarBackground.Thickness = 3
    HealthBarBackground.Transparency = 1

    local HealthBar = Drawing.new("Line")
    HealthBar.Visible = false
    HealthBar.Color = Color3.fromRGB(255, 0, 0)
    HealthBar.Thickness = 3
    HealthBar.Transparency = 1

    local DistanceText = Drawing.new("Text")
    DistanceText.Visible = false
    DistanceText.Color = Color3.fromRGB(255, 255, 255)
    DistanceText.Size = 8
    DistanceText.Center = false
    DistanceText.Outline = false

    local connection
    connection = RunService.RenderStepped:Connect(function()
        if ESPObjects[plr.Name] then
            if plr.Character ~= nil and plr.Character:FindFirstChildOfClass("Humanoid") ~= nil and plr.Character:FindFirstChild("HumanoidRootPart") ~= nil and plr.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
                local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
                local head = plr.Character:FindFirstChild("Head")

                if head and rootPart and ESPEnabled then
                    local headPos, headVisible = Camera:WorldToViewportPoint(head.Position)
                    local rootPos, rootVisible = Camera:WorldToViewportPoint(rootPart.Position)

                    if headVisible or rootVisible then
                        local screenHeight = Camera.ViewportSize.Y

                        local distance = (Camera.CFrame.Position - rootPart.Position).Magnitude
                        local boxHeight = math.clamp(screenHeight / (distance * 0.2), 10, 30)
                        local boxWidth = boxHeight * 0.4

                        local boxX = headPos.X - boxWidth / 2
                        local boxY = headPos.Y - boxHeight * 0.1

                        Box.Position = Vector2.new(boxX, boxY)
                        Box.Size = Vector2.new(boxWidth, boxHeight)
                        Box.Visible = true

                        if ESPShowHealth then
                            local health = humanoid.Health / humanoid.MaxHealth
                            local healthBarX = boxX + boxWidth + 5
                            local healthBarTop = boxY
                            local healthBarBottom = boxY + boxHeight

                            HealthBarBackground.From = Vector2.new(healthBarX, healthBarTop)
                            HealthBarBackground.To = Vector2.new(healthBarX, healthBarBottom)
                            HealthBarBackground.Visible = true

                            local healthBarCurrentBottom = healthBarTop + (boxHeight * health)
                            HealthBar.From = Vector2.new(healthBarX, healthBarTop)
                            HealthBar.To = Vector2.new(healthBarX, healthBarCurrentBottom)
                            HealthBar.Visible = true
                        else
                            HealthBarBackground.Visible = false
                            HealthBar.Visible = false
                        end

                        if ESPShowDistance then
                            local distanceInMeters = math.floor(distance)
                            DistanceText.Text = distanceInMeters .. "m"
                            DistanceText.Position = Vector2.new(boxX + boxWidth + 8, headPos.Y - 5)
                            DistanceText.Visible = true
                        else
                            DistanceText.Visible = false
                        end
                    else
                        Box.Visible = false
                        HealthBarBackground.Visible = false
                        HealthBar.Visible = false
                        DistanceText.Visible = false
                    end
                else
                    Box.Visible = false
                    HealthBarBackground.Visible = false
                    HealthBar.Visible = false
                    DistanceText.Visible = false
                end
            else
                Box.Visible = false
                HealthBarBackground.Visible = false
                HealthBar.Visible = false
                DistanceText.Visible = false
                if game.Players:FindFirstChild(plr.Name) == nil then
                    connection:Disconnect()
                    Box:Remove()
                    HealthBarBackground:Remove()
                    HealthBar:Remove()
                    DistanceText:Remove()
                    if ESPObjects[plr.Name] and ESPObjects[plr.Name].CharacterAddedConnection then
                        ESPObjects[plr.Name].CharacterAddedConnection:Disconnect()
                    end
                    ESPObjects[plr.Name] = nil
                end
            end
        else
            Box:Remove()
            HealthBarBackground:Remove()
            HealthBar:Remove()
            DistanceText:Remove()
            connection:Disconnect()
        end
    end)

    ESPObjects[plr.Name] = {
        Box = Box,
        HealthBar = HealthBar,
        HealthBarBackground = HealthBarBackground,
        DistanceText = DistanceText,
        Connection = connection,
        CharacterAddedConnection = nil -- будет установлено в ESPFunction
    }
end

local function ESPFunction(enabled)
    ESPEnabled = enabled
    if enabled then
        for _, v in pairs(Players:GetPlayers()) do
            if v ~= player and IsEnemy(v) and not ESPObjects[v.Name] then
                CreateESP(v)
                -- Подписка на возрождение
                if not ESPObjects[v.Name].CharacterAddedConnection then
                    ESPObjects[v.Name].CharacterAddedConnection = v.CharacterAdded:Connect(function()
                        local espData = ESPObjects[v.Name]
                        if espData then
                            if espData.Box then espData.Box:Remove() end
                            if espData.HealthBar then espData.HealthBar:Remove() end
                            if espData.HealthBarBackground then espData.HealthBarBackground:Remove() end
                            if espData.DistanceText then espData.DistanceText:Remove() end
                            if espData.Connection then espData.Connection:Disconnect() end
                            if espData.CharacterAddedConnection then espData.CharacterAddedConnection:Disconnect() end
                            ESPObjects[v.Name] = nil
                        end
                        wait(0.5)
                        if ESPEnabled and v ~= player and IsEnemy(v) then
                            CreateESP(v)
                        end
                    end)
                end
            end
        end

        ESPConnection = Players.PlayerAdded:Connect(function(newPlayer)
            if newPlayer ~= player and IsEnemy(newPlayer) and not ESPObjects[newPlayer.Name] then
                wait(1)
                CreateESP(newPlayer)
                if not ESPObjects[newPlayer.Name].CharacterAddedConnection then
                    ESPObjects[newPlayer.Name].CharacterAddedConnection = newPlayer.CharacterAdded:Connect(function()
                        local espData = ESPObjects[newPlayer.Name]
                        if espData then
                            if espData.Box then espData.Box:Remove() end
                            if espData.HealthBar then espData.HealthBar:Remove() end
                            if espData.HealthBarBackground then espData.HealthBarBackground:Remove() end
                            if espData.DistanceText then espData.DistanceText:Remove() end
                            if espData.Connection then espData.Connection:Disconnect() end
                            if espData.CharacterAddedConnection then espData.CharacterAddedConnection:Disconnect() end
                            ESPObjects[newPlayer.Name] = nil
                        end
                        wait(0.5)
                        if ESPEnabled and newPlayer ~= player and IsEnemy(newPlayer) then
                            CreateESP(newPlayer)
                        end
                    end)
                end
            end
        end)
    else
        RemoveAllESP()
        if ESPConnection then
            ESPConnection:Disconnect()
            ESPConnection = nil
        end
    end
end

--// Tracer (с автообновлением при смерти/возрождении)
local TracerObjects = {}
local TracerEnabled = false
local TracerConnection = nil

local function RemoveAllTracers()
    for playerName, tracerData in pairs(TracerObjects) do
        if tracerData.Line then tracerData.Line:Remove() end
        if tracerData.Connection then tracerData.Connection:Disconnect() end
        if tracerData.CharacterAddedConnection then tracerData.CharacterAddedConnection:Disconnect() end
        TracerObjects[playerName] = nil
    end
end

local function CreateTracer(plr)
    local Line = Drawing.new("Line")
    Line.Visible = false
    Line.Color = Color3.fromRGB(255, 255, 255)
    Line.Thickness = 1
    Line.Transparency = 1

    local connection
    connection = RunService.RenderStepped:Connect(function()
        if TracerObjects[plr.Name] then
            if plr.Character ~= nil and plr.Character:FindFirstChildOfClass("Humanoid") ~= nil and plr.Character:FindFirstChild("HumanoidRootPart") ~= nil and plr.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                local targetRoot = plr.Character:FindFirstChild("HumanoidRootPart")

                if targetRoot and TracerEnabled and ESPShowTracer then
                    local targetPos = targetRoot.Position
                    local targetScreenPos, targetVisible = Camera:WorldToViewportPoint(targetPos)
                    local screenBottom = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)

                    if targetVisible then
                        Line.From = screenBottom
                        Line.To = Vector2.new(targetScreenPos.X, targetScreenPos.Y)
                        Line.Visible = true
                    else
                        Line.Visible = false
                    end
                else
                    Line.Visible = false
                end
            else
                Line.Visible = false
                if game.Players:FindFirstChild(plr.Name) == nil then
                    connection:Disconnect()
                    Line:Remove()
                    if TracerObjects[plr.Name] and TracerObjects[plr.Name].CharacterAddedConnection then
                        TracerObjects[plr.Name].CharacterAddedConnection:Disconnect()
                    end
                    TracerObjects[plr.Name] = nil
                end
            end
        else
            Line:Remove()
            connection:Disconnect()
        end
    end)

    TracerObjects[plr.Name] = {
        Line = Line,
        Connection = connection,
        CharacterAddedConnection = nil
    }
end

local function TracerFunction(enabled)
    TracerEnabled = enabled
    if enabled and ESPShowTracer then
        RemoveAllTracers()

        for _, v in pairs(Players:GetPlayers()) do
            if v ~= player and IsEnemy(v) and not TracerObjects[v.Name] then
                CreateTracer(v)
                if not TracerObjects[v.Name].CharacterAddedConnection then
                    TracerObjects[v.Name].CharacterAddedConnection = v.CharacterAdded:Connect(function()
                        local tracerData = TracerObjects[v.Name]
                        if tracerData then
                            if tracerData.Line then tracerData.Line:Remove() end
                            if tracerData.Connection then tracerData.Connection:Disconnect() end
                            if tracerData.CharacterAddedConnection then tracerData.CharacterAddedConnection:Disconnect() end
                            TracerObjects[v.Name] = nil
                        end
                        wait(0.5)
                        if TracerEnabled and ESPShowTracer and v ~= player and IsEnemy(v) then
                            CreateTracer(v)
                        end
                    end)
                end
            end
        end

        if TracerConnection then
            TracerConnection:Disconnect()
        end

        TracerConnection = Players.PlayerAdded:Connect(function(newPlayer)
            if newPlayer ~= player and IsEnemy(newPlayer) and ESPShowTracer and not TracerObjects[newPlayer.Name] then
                wait(1)
                CreateTracer(newPlayer)
                if not TracerObjects[newPlayer.Name].CharacterAddedConnection then
                    TracerObjects[newPlayer.Name].CharacterAddedConnection = newPlayer.CharacterAdded:Connect(function()
                        local tracerData = TracerObjects[newPlayer.Name]
                        if tracerData then
                            if tracerData.Line then tracerData.Line:Remove() end
                            if tracerData.Connection then tracerData.Connection:Disconnect() end
                            if tracerData.CharacterAddedConnection then tracerData.CharacterAddedConnection:Disconnect() end
                            TracerObjects[newPlayer.Name] = nil
                        end
                        wait(0.5)
                        if TracerEnabled and ESPShowTracer and newPlayer ~= player and IsEnemy(newPlayer) then
                            CreateTracer(newPlayer)
                        end
                    end)
                end
            end
        end)
    else
        RemoveAllTracers()
        if TracerConnection then
            TracerConnection:Disconnect()
            TracerConnection = nil
        end
    end
end

--// Создание кнопки Spawn Locations
local TeleportFunction = CreateFunctionInTab(TeleportTabContent, "Spawn Locations", "Teleport to spawns", 1, function(enabled)
    if enabled then
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local spawnLocation = player.RespawnLocation

            if spawnLocation then
                player.Character.HumanoidRootPart.CFrame = spawnLocation.CFrame
                ShowNotification("Teleport you")
            else
                local spawns = {}
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if obj:IsA("SpawnLocation") then
                        table.insert(spawns, obj)
                    end
                end

                if #spawns > 0 then
                    player.Character.HumanoidRootPart.CFrame = spawns[1].CFrame
                    ShowNotification("Teleport you")
                else
                    ShowNotification("No spawn found!")
                end
            end
        else
            ShowNotification("Character not found!")
        end
    end
end)

