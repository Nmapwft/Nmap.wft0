TracerButton.MouseButton1Click:Connect(function()
    ESPShowTracer = not ESPShowTracer
    if ESPShowTracer then
        TweenService:Create(TracerCheckbox, TweenInfo.new(0.2), {BackgroundColor3 = Colors.CheckboxOn}):Play()
        TracerEnabled = true
        TracerFunction(true)
    else
        TweenService:Create(TracerCheckbox, TweenInfo.new(0.2), {BackgroundColor3 = Colors.CheckboxOff}):Play()
        RemoveAllTracers()
    end
end)

