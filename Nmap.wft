            {Size = UDim2.new(1, -8, 0, totalHeight)}):Play()
    else
        TweenService:Create(TeleportPlayersFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            {Size = UDim2.new(1, -8, 0, 0)}):Play()
